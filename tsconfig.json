{
    "compilerOptions": {
        "moduleResolution": "bundler",
        "module": "ES2022",
        "removeComments": true,
        "target": "ES2022",
        "rootDir": "./src/",
        "outDir": "./out/",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "noImplicitAny": true,
        "noUnusedLocals": true,
        "strict": true
    },
    "include": ["./src/**/*"]
}
